# Placeholders only. Set real values in private environment/secret storage.
# DATABASE_URL: Neon pooled URL, postgresql+psycopg://..., sslmode=require.
DATABASE_URL=
# MIGRATION_DATABASE_URL: same branch/database, DIRECT URL, SSL required.
# Operator-only; do not provision this secret to the Vercel runtime.
MIGRATION_DATABASE_URL=
DATABASE_POOL_MODE=null
DATABASE_SSL_REQUIRED=1
APP_ENV=production
PUBLIC_ORIGIN=
ALLOWED_HOSTS=
